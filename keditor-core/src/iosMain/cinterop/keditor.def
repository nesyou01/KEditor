headers =        keditor.h


linkerOpts =     -liconv \
                 -framework AudioToolbox \
                 -framework CoreMedia \
                 -framework CoreVideo \
                 -framework VideoToolbox \
                 -framework AVFoundation \
                 -framework CoreFoundation


staticLibraries = libavcodec.a \
                  libavdevice.a \
                  libavfilter.a \
                  libavformat.a \
                  libavutil.a \
                  libswresample.a \
                  libswscale.a \
                  libx264.a \
                  libkeditor.a
