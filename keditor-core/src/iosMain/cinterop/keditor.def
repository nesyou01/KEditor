headers =       libavutil/avutil.h \
                libavcodec/avcodec.h \
                libavformat/avformat.h \
                libavfilter/avfilter.h \
                libswscale/swscale.h \
                libswresample/swresample.h

headerFilter =  libavutil/* \
                libavcodec/* \
                libavformat/* \
                libavfilter/* \
                libswscale/* \
                libswresample/*

linkerOpts =     -lavutil \
                 -lavcodec \
                 -lavdevice \
                 -lavfilter \
                 -lavformat \
                 -lswresample \
                 -lswscale

staticLibraries = libavcodec.a \
                  libavdevice.a \
                  libavfilter.a \
                  libavformat.a \
                  libavutil.a \
                  libswresample.a \
                  libswscale.a
