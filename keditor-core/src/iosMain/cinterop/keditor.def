headers =       libavutil/avutil.h \
                libavcodec/avcodec.h \
                libavformat/avformat.h \
                libavfilter/avfilter.h \
                libswscale/swscale.h \
                libswresample/swresample.h \
                x264.h \
                x264_config.h

headerFilter =  libavutil/* \
                libavcodec/* \
                libavformat/* \
                libavfilter/* \
                libswscale/* \
                libswresample/*

linkerOpts =     -liconv \
                 -framework AudioToolbox \
                 -framework CoreMedia \
                 -framework CoreVideo \
                 -framework VideoToolbox \
                 -framework AVFoundation \
                 -framework CoreFoundation


staticLibraries = libavcodec.a \
                  libavdevice.a \
                  libavfilter.a \
                  libavformat.a \
                  libavutil.a \
                  libswresample.a \
                  libswscale.a \
                  libx264.a
